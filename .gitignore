# Compiled binaries -- every `when isMainModule` block (and every example)
# produces one, named after its source file with no extension, so ignore
# extensionless files by default instead of listing each binary here.
*
!*/
!*.*
!/LICENSE

# Nim won't write a compiled binary's output over a same-named directory
# (e.g. argumint.nim sits next to argumint/, configsource.nim next to
# configsource/) -- it renames the output to <module>.out instead, which
# has an extension and so escapes the blanket rule above.
*.out

# Nim build artifacts
nimcache/
*.exe
*.pdb

# setup-nim-action installs the toolchain here (workspace-relative default);
# CI caches it, see .github/workflows/test.yml
.nim_runtime/

# Generated by `nimble docs` -- built and published by CI, not checked in
/htmldocs/

# Claude Code's local settings/lock files -- machine-specific, not shared
/.claude/
