# Built with every `newSpecSettings` default overridden, as a program's
# author or packager would with `-d:` -- see ADR 0053.
switch("define", "argumint.width=72")
switch("define", "argumint.maxWidth=90")
switch("define", "argumint.maxVariantsWidth=40")
switch("define", "argumint.envDelim=,")
switch("define", "argumint.strictOptions=false")
